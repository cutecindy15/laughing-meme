<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xml xmlns="http://www.w3.org/1999/xhtml">

  <!-- CHECKOUT & DELIVERY LOGIC -->
  
  <!-- PROCESS ORDER PROCEDURE -->
  <block type="procedures_defnoreturn" id="proc_process_order" x="30" y="600">
    <mutation/>
    <field name="NAME">ProcessOrder</field>
    <comment pinned="false" h="80" w="160">Process the order and save to OrdersList</comment>
    <statement name="STACK">
      <block type="variables_set" id="set_order_id">
        <field name="VAR">OrderID</field>
        <value name="VALUE">
          <block type="math_arithmetic" id="generate_id">
            <field name="OP">ADD</field>
            <value name="A">
              <block type="lists_length" id="orders_count">
                <value name="LIST">
                  <block type="variables_get" id="get_orders_count">
                    <field name="VAR">OrdersList</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="one_order">
                <field name="NUM">1</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="variables_set" id="set_delivery_date">
            <field name="VAR">DeliveryDate</field>
            <value name="VALUE">
              <block type="text_join" id="calc_delivery">
                <mutation items="2"/>
                <value name="ADD0">
                  <block type="text" id="delivery_in">
                    <field name="TEXT">Delivery in </field>
                  </block>
                </value>
                <value name="ADD1">
                  <block type="variables_get" id="get_delivery_option">
                    <field name="VAR">SelectedDelivery</field>
                  </block>
                </value>
              </block>
            </value>
            <next>
              <block type="lists_append_list" id="add_to_orders">
                <value name="LIST">
                  <block type="variables_get" id="get_orders_append">
                    <field name="VAR">OrdersList</field>
                  </block>
                </value>
                <value name="ITEM">
                  <block type="lists_create_with" id="create_order">
                    <mutation items="4"/>
                    <value name="ADD0">
                      <block type="variables_get" id="order_id">
                        <field name="VAR">OrderID</field>
                      </block>
                    </value>
                    <value name="ADD1">
                      <block type="variables_get" id="order_total">
                        <field name="VAR">Total</field>
                      </block>
                    </value>
                    <value name="ADD2">
                      <block type="variables_get" id="order_delivery">
                        <field name="VAR">DeliveryDate</field>
                      </block>
                    </value>
                    <value name="ADD3">
                      <block type="variables_get" id="order_address">
                        <field name="VAR">DeliveryAddress</field>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="variables_set" id="clear_cart">
                    <field name="VAR">CartList</field>
                    <value name="VALUE">
                      <block type="lists_create_empty" id="empty_cart_after"/>
                    </value>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <!-- CALCULATE DELIVERY COST -->
  <block type="procedures_defreturn" id="proc_calc_delivery" x="300" y="600">
    <mutation/>
    <field name="NAME">CalculateDeliveryCost</field>
    <comment pinned="false" h="80" w="160">Calculate delivery cost based on option</comment>
    <statement name="STACK">
      <block type="controls_if" id="check_delivery_type">
        <mutation else="1"/>
        <value name="IF0">
          <block type="logic_compare" id="is_express">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_delivery_type">
                <field name="VAR">SelectedDelivery</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="express_text">
                <field name="TEXT">Express (1-2 days)</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="procedures_return" id="return_express">
            <value name="VALUE">
              <block type="math_number" id="express_cost">
                <field name="NUM">100</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="procedures_return" id="return_standard">
            <value name="VALUE">
              <block type="math_number" id="standard_cost">
                <field name="NUM">50</field>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- GET ESTIMATED DELIVERY DAYS -->
  <block type="procedures_defreturn" id="proc_get_delivery_days" x="600" y="600">
    <mutation/>
    <field name="NAME">GetEstimatedDeliveryDays</field>
    <comment pinned="false" h="80" w="160">Returns estimated delivery days</comment>
    <statement name="STACK">
      <block type="controls_if" id="check_days">
        <mutation else="1"/>
        <value name="IF0">
          <block type="logic_compare" id="is_express_days">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="variables_get" id="get_delivery_days">
                <field name="VAR">SelectedDelivery</field>
              </block>
            </value>
            <value name="B">
              <block type="text" id="express_days_text">
                <field name="TEXT">Express (1-2 days)</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="procedures_return" id="return_express_days">
            <value name="VALUE">
              <block type="text" id="express_days">
                <field name="TEXT">1-2 days</field>
              </block>
            </value>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="procedures_return" id="return_standard_days">
            <value name="VALUE">
              <block type="text" id="standard_days">
                <field name="TEXT">3-5 days</field>
              </block>
            </value>
          </block>
        </statement>
      </block>
    </statement>
  </block>

  <!-- FORMAT ORDER FOR DISPLAY -->
  <block type="procedures_defreturn" id="proc_format_order" x="900" y="600">
    <mutation/>
    <field name="NAME">FormatOrderDisplay</field>
    <comment pinned="false" h="80" w="160">Format order information for display</comment>
    <statement name="STACK">
      <block type="procedures_return" id="return_formatted">
        <value name="VALUE">
          <block type="text_join" id="format_text">
            <mutation items="5"/>
            <value name="ADD0">
              <block type="text" id="order_text_1">
                <field name="TEXT">Order #</field>
              </block>
            </value>
            <value name="ADD1">
              <block type="variables_get" id="fmt_order_id">
                <field name="VAR">OrderID</field>
              </block>
            </value>
            <value name="ADD2">
              <block type="text" id="order_text_2">
                <field name="TEXT"> - Rs.</field>
              </block>
            </value>
            <value name="ADD3">
              <block type="variables_get" id="fmt_order_total">
                <field name="VAR">Total</field>
              </block>
            </value>
            <value name="ADD4">
              <block type="text" id="order_text_3">
                <field name="TEXT"> - Arriving soon</field>
              </block>
            </value>
          </block>
        </value>
      </block>
    </statement>
  </block>

</xml>